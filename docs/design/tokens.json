{
  "$description": "Agent Ops design tokens (Swiss Instrument). Mirrors tokens.css; source: prototype/app.dc.html.",
  "color": {
    "light": {
      "bg": "#FFFFFF", "bg-sub": "#F6F6F6", "surface": "#FFFFFF",
      "ink": "#0A0A0A", "ink-2": "#404040", "muted": "#6B6B6B",
      "line": "#E6E6E6", "line-strong": "#0A0A0A",
      "attn": "#FF4F00", "attn-ink": "#B83A00", "attn-bg": "#FFF1EA", "on-attn": "#0A0A0A",
      "live": "#0047FF", "ok": "#1F7A4A"
    },
    "dark": {
      "bg": "#0B0B0C", "bg-sub": "#17171A", "surface": "#141416",
      "ink": "#F2F2F2", "ink-2": "#C8C8C8", "muted": "#9A9A9A",
      "line": "#26262A", "line-strong": "#F2F2F2",
      "attn": "#FF5A14", "attn-ink": "#FF8A52", "attn-bg": "#2A160C", "on-attn": "#0A0A0A",
      "live": "#7B93FF", "ok": "#4CC38A"
    },
    "console": {
      "bg": "#0A0A0A", "fg": "#E6E6E6", "muted": "#8A8A8A", "out-bg": "#141414",
      "stage": "#7B93FF", "ok": "#4CC38A", "err": "#FF8A52"
    }
  },
  "font": {
    "sans": "Geist, 'Helvetica Neue', Arial, sans-serif",
    "mono": "'Geist Mono', ui-monospace, monospace"
  },
  "type": {
    "display": { "family": "sans", "size": 56, "weight": 700, "lineHeight": 0.9, "letterSpacing": "-0.05em" },
    "metric":  { "family": "sans", "size": 44, "weight": 300, "lineHeight": 1, "letterSpacing": "-0.045em", "numeric": "tabular-nums" },
    "title":   { "family": "sans", "size": 22, "weight": 600, "lineHeight": 1.2, "letterSpacing": "-0.03em" },
    "card":    { "family": "sans", "size": 15, "weight": 600, "lineHeight": 1.3, "letterSpacing": "-0.01em" },
    "body":    { "family": "sans", "size": 14, "weight": 400, "lineHeight": 1.45 },
    "label":   { "family": "mono", "size": 10.5, "weight": 400, "transform": "uppercase", "letterSpacing": "0.04em", "color": "muted" }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "pageGutter": 32 },
  "radius": 0,
  "control": { "height": 40, "heightSm": 32, "heightPrimary": 44 },
  "focus": { "width": 2, "color": "live", "offset": 2 },
  "motion": { "duration": 150, "easing": "ease-out", "animate": "colour only; respect prefers-reduced-motion" }
}
